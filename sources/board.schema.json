{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Pin Atlas profile",
  "type": "object",
  "required": ["id", "name", "family", "mcu", "voltage", "source", "datasheet", "verifiedOn", "layout", "packagePins", "gpioCount", "pins"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "mcu": {"type": "string", "minLength": 1},
    "voltage": {"type": "string", "minLength": 1},
    "source": {"type": "string", "pattern": "^https://"},
    "datasheet": {"type": "string", "pattern": "^https://"},
    "verifiedOn": {"type": "string", "format": "date"},
    "layout": {"enum": ["pico", "header", "custom", "qfn", "lqfp", "dip"]},
    "packagePins": {"type": "integer", "minimum": 1},
    "gpioCount": {"type": "integer", "minimum": 0},
    "mcuProfile": {"type": "string", "minLength": 1},
    "pins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pin"}}
  },
  "$defs": {
    "function": {
      "type": "object", "required": ["name", "signal", "group", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "signal": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1},
        "configurationEvidence": {"type": "string", "minLength": 1},
        "configuration": {"type": "object", "required": ["field", "values"], "properties": {
          "field": {"type": "string", "minLength": 1}, "values": {"type": "array", "minItems": 1}
        }}
      }
    },
    "pin": {
      "type": "object", "required": ["number", "name", "type", "functions", "evidence"],
      "properties": {
        "number": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["GPIO", "POWER", "GND", "SYSTEM", "ADC"]},
        "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mcuPin": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"}]}, "connector": {"type": "string", "minLength": 1},
        "position": {"type": "object", "required": ["x", "y", "side"], "properties": {
          "x": {"type": "number"}, "y": {"type": "number"}, "side": {"enum": ["left", "right", "top", "bottom"]}
        }}
      }
    }
  }
}
