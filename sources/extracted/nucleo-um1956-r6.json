          ],
          [
            "SB16",
            "ON",
            "STM32 PB6 is connected to CN4 pin 7 for I2C SCL support on\nARDUINO®\nNano A5. In such case, STM32 PB6 does not support\nARDUINO®\nNano D5 and PA6 must be configured as input floating."
          ],
          [
            "SB16",
            "OFF",
            "CN4 pin 7 is used as ARDUINO® Nano analog input A5 without I2C\nARDUINO®\nsupport and CN3 pin 8 is available as Nano D5."
          ]
